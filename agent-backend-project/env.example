# 运行环境：development / production
APP_ENV=development

# 必填：数据库连接串（敏感信息）
MYSQL_URL="mysql+pymysql://root:a1994*@localhost:3306/agent_project_database?charset=utf8mb4"


# JWT 签名密钥，用于生成和验证令牌，可根据实际情况修改。
JWT_SECRET="dev_change_me_please"
# JWT 签名算法，例如 HS256等。
JWT_ALGORITHM="HS256"
# Access Token 的有效期（分钟）
JWT_ACCESS_EXPIRE_MINUTES=120
# Refresh Token 的有效期（分钟）。通常设置较长，如 7 天 (10080 分钟)。
JWT_REFRESH_EXPIRE_MINUTES=10080

# 允许跨域的前端源（逗号分隔）。留空 = 只放行本机 localhost:8080 / 127.0.0.1:8080。
# 生产用 nginx 反代 /api 时前后端同源，其实用不到这条；只有"前端域名直连后端域名"
# 的架构才必须配，例如：CORS_ORIGINS=https://learn.example.com,https://www.example.com
CORS_ORIGINS=


# 腾讯云 COS 对象存储配置（app/core/settings.py）
# 存储桶名必须带 APPID 后缀（BucketName-APPID），且需预先在 COS 控制台创建
COS_SECRET_ID = "AKIDxxxxxxxxxxxxxxxxxxxxxxxx"
COS_SECRET_KEY = "xxxxxxxxxxxxxxxxxxxxxxxx"
COS_REGION = "ap-beijing"
COS_BUCKET = "your-bucket-1250000000"

# OpenAI 兼容接口（如 DeepSeek）：必填密钥，否则流式对话无法调用模型
DEEPSEEK_API_KEY=sk-9ec1d734912d48ce219780dc45578
# 以下为可选；不填则使用代码内默认值
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=1024

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# # 阿里百炼千问模型秘钥
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Qdrant 向量数据库（地址跨环境会变；collection 名作为代码常量）
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 短期记忆配置
INSTANT_MEMORY_MAX_CHARS=12000

# 火山引擎模型秘钥
VOLC_ACCESS_KEY="用户标识ID"
VOLC_SECRET_KEY="验证用户的秘钥"
VOLC_REGION=cn-north-1

# ---------------------------------------------------------------
# 豆包 Seedream 文生图（难点讲解：知识卡配图）
# ---------------------------------------------------------------
# 走火山方舟的 OpenAI 兼容接口。**留空 SEEDREAM_API_KEY = 优雅降级**：难点讲解
# 只出结构化知识卡、不出图，其余链路照常（与 DASHSCOPE / VOLC 同一策略）。
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ⚠️ 模型 ID 必须写"连字符 + 日期"的规范形式（`-5-0-`，不是 `-5.0-`）。
# 实测：`doubao-seedream-5.0-260128`（带点）必定 404 InvalidEndpointOrModel.NotFound，
# 因为项目最初是照抄文档里的**展示名**而不是 API 的 `id`。
# 下面这个值是实测可调通的；改之前先用 `scripts/check_seedream.py` 验证。
# 可选：`doubao-seedream-5-0-pro-260628`（质量更好，但需在方舟控制台先"开通"该模型）。
SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
# 尺寸是"档位"（2k / 4k 这类），不是 1024x1024——写像素值会被服务端拒掉
SEEDREAM_SIZE=2k
# 出图调用超时（秒）：单张实测数十秒，别配太小
SEEDREAM_TIMEOUT_SECONDS=120
# 下载生成图超时（秒）：方舟返回的是 CDN 直链，慢网下要给足
SEEDREAM_DOWNLOAD_TIMEOUT_SECONDS=60

# 短期记忆配置
INSTANT_MEMORY_LIMIT=8
INSTANT_MEMORY_MAX_CHARS=10000
WORKING_MEMORY_TTL_SECONDS = 28800

# 默认入口：loop=不选智能体时一律进 agent loop（默认）；gated=简单问答走单轮聊天
AGENT_ENTRY_MODE=loop

# 日志目录；留空 = 项目根/logs。容器或只读代码盘下指到可写位置
LOG_DIR=

# ---------------------------------------------------------------
# MCP（Model Context Protocol，第 3 期）
# ---------------------------------------------------------------
# 默认关闭：开启后外部 MCP server 可以读到用户资料，模型也可以调用外部工具。
# 必须由部署方显式打开，并把 MCP_SERVERS 配成"你信任的 server"。
MCP_ENABLED=false
# 连接 server + 列工具的超时（秒）
MCP_CONNECT_TIMEOUT_SECONDS=20
# 单次 MCP 工具调用超时（秒）；超时会被收敛成给模型看的错误，不会打断 agent loop
MCP_CALL_TIMEOUT_SECONDS=60
# 要连接的 MCP server 列表（JSON 数组）。三种写法：
#   stdio：自己起子进程（command/args/cwd/env）
#   streamable-http：连远端服务（url）
#   enabled=false：先写下来但这次不连
#
# 例 A：第三方只读抓取（把 URL 读成 markdown，**不能搜索**）
#   `env` 段会把变量注入子进程——API key 这类东西应该这样传，不要写死在代码里。
# MCP_SERVERS=[{"name":"fetch","transport":"stdio","command":"mcp-server-fetch"}]
#
# 例 B（已接入）：官方 time server（stdio）+ DeepWiki 远端（streamable-http）。
#   time 先 pip install mcp-server-time==2026.10.10（之后的版本要求 mcp 2.x，
#   与本仓钉死的 mcp==1.30.0 冲突）；deepwiki 无需安装，走远端 HTTP，离线时
#   连接失败自动降级成"没有该工具"。
# MCP_SERVERS=[{"name":"time","transport":"stdio","command":"python","args":["-m","mcp_server_time","--local-timezone=Asia/Shanghai"]},{"name":"deepwiki","transport":"streamable-http","url":"https://mcp.deepwiki.com/mcp"}]
#
# 注意：不要再配 `python -m app.agent.mcp.server`（本项目自带的 learning-kb）。
# 那是"把本进程已有的能力绕一圈子进程再调回来"，只会多一套鉴权路径和故障面；
# 它存在的意义是给**外部 host**（Claude Desktop / MCP Inspector）读知识库，
# 配法见 app/agent/mcp/server.py 的文档字符串。
# 自研新 server（如学习报告、笔记检索）不受此限制：按"优先供本项目 loop 使用"的
# 定位直接配进 MCP_SERVERS；learning-kb 例外的原因是它的能力与内置工具完全重复。
MCP_SERVERS=[]

# 自建 MCP server 以谁的身份查询（只有 `python -m app.agent.mcp.server` 会读它）。
# 不设时：库里恰好只有一个用户才自动采用它，否则工具会返回"必须指定身份"的报错。
MCP_USER_ID=

